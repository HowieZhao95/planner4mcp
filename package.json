{
  "name": "planner4mcp",
  "version": "0.2.0",
  "description": "MCP server for Apple Calendar and Reminders (EventKit), full CRUD",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HowieZhao95/planner4mcp.git"
  },
  "type": "module",
  "bin": {
    "planner4mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "bin",
    "swift",
    "scripts",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build:bridge": "bash scripts/build-bridge.sh",
    "build:ts": "tsc -p tsconfig.json",
    "build": "npm run build:bridge && npm run build:ts",
    "start": "node dist/index.js",
    "access": "./build/ekbridge --request-access",
    "test": "npm run build && node scripts/verify.mjs",
    "smoke": "npm run build:ts && node scripts/smoke.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
