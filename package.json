{
  "name": "planner4mcp",
  "version": "0.1.0",
  "description": "MCP server for Apple Calendar and Reminders (EventKit), full CRUD",
  "type": "module",
  "bin": {
    "planner4mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "build/ekbridge",
    "swift",
    "scripts"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build:bridge": "bash scripts/build-bridge.sh",
    "build:ts": "tsc -p tsconfig.json",
    "build": "npm run build:bridge && npm run build:ts",
    "start": "node dist/index.js",
    "access": "./build/ekbridge --request-access"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
